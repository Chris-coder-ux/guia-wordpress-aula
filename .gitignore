# =============================================================================
# .gitignore — Repositorio IFCD0110 (prácticas de aula)
# =============================================================================

# --- Respaldo y renders temporales del proyecto (no suben a GitHub) ---
_backup/
_renderbak/

# --- Registros de pruebas de navegador (Playwright MCP) ---
.playwright-mcp/

# --- Trabajo temporal del agente / issue tracker ---
.scratch/
docs/agents/

# --- Lock de skills del agente (no parte del proyecto docente) ---
skills-lock.json

# --- Carpetas de agentes e IDEs (configuración local, no parte del proyecto) ---
.agents/
.augment/
.claude/
.codebuddy/
.codewhale/
.codex/
.continue/
.cursor/
.factory/
.gemini/
.impeccable/
.kilocode/
.kiro/
.opencode/
.qoder/
.roo/
.trae/
.warp/
.windsurf/

# --- Python ---
__pycache__/
*.py[cod]
*.pyc
*.pyd

# --- Backups y restaurados sueltos ---
*.bak
*.restored

# --- Archivos del sistema operativo ---
.DS_Store
Thumbs.db

# --- Logs ---
*.log
